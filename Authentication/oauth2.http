# }

# ### 4. Authorize (Browser Step - Manual)
# # ------------------------------------------------------------------
# # Copy the URL below, REPLACE THE PLACEHOLDERS with your actual values,
# # and paste it into your browser.
# # 
# # http://localhost:10000/oauth2/authorize?response_type=code&client_id=YOUR_CLIENT_ID&scope=openid profile read write&redirect_uri=YOUR_REDIRECT_URI
# #
# # 1. You will be asked to login (if not already).
# # 2. You will be redirected to: YOUR_REDIRECT_URI?code=YOUR_AUTH_CODE
# # 3. Copy the 'code' value from the URL bar.
# # ------------------------------------------------------------------

