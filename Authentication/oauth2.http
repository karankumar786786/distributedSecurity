# ### 2. Login (Password) to get Session Cookie
# POST http://localhost:10000/auth/login/password
# Content-Type: application/json
# X-Temp-Token: {{temp_token}}

# {
#     "credential": "password",
#     "loginId": "{{temp_token}}"
# }

# ### 3. Create OAuth2 Client (Requires Login Session)
# # Skipping this step if you already have Client ID/Secret.
# # If not, run this after running Request #2.
# POST http://localhost:10000/api/clients
# Content-Type: application/json
# {
#     "clientName": "Test App",
