pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = "authentication:latest"
        K8S_NAMESPACE = "distributed-security"
        REGISTRY_CREDENTIALS = "docker-registry-credentials"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                dir('Authentication') {
                    sh './mvnw clean package -DskipTests'
                }
            }
        }
        
        stage('Dockerize') {
            steps {
                script {
                    docker.withRegistry('', REGISTRY_CREDENTIALS) {
                        def img = docker.build("${DOCKER_IMAGE}", "Authentication/.")
                        img.push()
                    }
                }
            }
        }
        
        stage('Deploy') {
            steps {
                sh "kubectl apply -f k8s/authentication.yaml -n ${K8S_NAMESPACE}"
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}
