### User Registration
POST http://localhost:10000/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123",
  "phoneNumber": "1234567890"
}

### Check User Exist
# @name checkUser
POST http://localhost:10000/auth/check-user-exist
Content-Type: application/json

{
  "username": "testuser",
  "reason": "LOGIN"
}

> {%
    if (response.status === 200) {
        if (!response.body.exist) {
             client.log("WARNING: User does not exist. Please run the 'User Registration' request first!");
        } else if (response.body.token) {
            client.global.set("temp_token", response.body.token);
            client.log("Temp Token set successfully: " + client.global.get("temp_token"));
        } else {
             client.log("Error: User exists but no token returned. Reason: " + JSON.stringify(response.body));
        }
    } else {
        client.log("Error: Failed to check user. Status: " + response.status + ", Body: " + JSON.stringify(response.body));
    }
%}

### User Login
# @name login
POST http://localhost:10000/auth/login/password
Content-Type: application/json
# IMPORTANT: You must run the "Check User Exist" request above first to generate the {{temp_token}}
X-Temp-Token: {{temp_token}}

{
  "credential": "password123"
}

> {%
    client.global.set("auth_token", response.body.accessToken);
    client.log("Auth Token: " + client.global.get("auth_token"));
%}

### Client Registration
# @name registerClient
POST http://localhost:10002/oauth2/client/register
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "redirectUrl": "http://localhost:8080/callback",
  "clientName": "Test Client",
  "scopes": ["read", "write"]
}

> {%
    client.global.set("client_id", response.body.clientId);
    client.global.set("client_secret", response.body.clientSecret);
    client.log("Client ID: " + client.global.get("client_id"));
%}

### Authorize (Get Code)
# @name authorize
POST http://localhost:10002/oauth2/authorize
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "client_id": "{{client_id}}",
  "scope": "read write"
}

> {%
    if (response.status === 200) {
        if (response.body.code) {
            client.global.set("auth_code", response.body.code);
            client.log("Auth Code: " + client.global.get("auth_code"));
        } else {
            client.log("Error: response.body.code is missing. Body: " + JSON.stringify(response.body));
        }
    } else {
        client.log("Error: Request failed with status " + response.status);
        client.log("Response Body: " + JSON.stringify(response.body));
    }
%}

### Exchange Code for Token
POST http://localhost:10002/oauth2/token
Content-Type: application/json

{
  "grant_type": "authorization_code",
  "code": "{{auth_code}}",
  "client_id": "{{client_id}}",
  "client_secret": "{{client_secret}}"
}
